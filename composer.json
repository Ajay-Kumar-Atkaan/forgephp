{
    "name": "ajay-kumar-atkaan/forgephp",
    "description": "A lightweight PHP MVC framework for learning and experimentation.",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        },
        "files" : [
            "helpers/helpers.php"
        ]

    },
    "authors": [
        {
            "name": "Ajay Kumar Atkaan",
            "email": "evanasuka4@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "vlucas/phpdotenv": "5.6.x-dev"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.x-dev"
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "tests/"
        },
        "files" : [
            "helpers/helpers.php"
        ]

    }
}
